{
  "name": "Enterprise AI CEO Assistant",
  "nodes": [
    {
      "parameters": {
        "content": "## 1. Intake & Understand\nEmail Trigger receives the CEO email → Extract CEO Message normalizes subject/body/sender → CEO AI Agent (Gemini) classifies it and generates the deliverable as structured JSON."
      },
      "id": "d1542d29-76ca-4b2c-a9c8-2c3835f5a0d8",
      "name": "Sticky Note d1542d29",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        416,
        -208
      ]
    },
    {
      "parameters": {
        "content": "## 2. Route & Act\nRoute By Category (Switch) sends the request to the matching branch. Email → Gmail, Meeting → Google Calendar. Sales/Finance/Reports/Research/General are content branches (extend them later). Fallback catches anything unclassified."
      },
      "id": "79a4b2a3-0563-446c-8a84-1a0b4abfd186",
      "name": "Sticky Note 79a4b2a3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        224
      ]
    },
    {
      "parameters": {
        "content": "## 3. Log & Reply\nAll branches converge → Build Log Entry → append to Google Sheets → email the final status back to the CEO. Action nodes use \"continue on error\" so logging and the reply always run."
      },
      "id": "524a96e3-dd54-43b6-83b0-f046672f9fc1",
      "name": "Sticky Note 524a96e3",
      "type": "n8n-nodes-base.stickyNote",
