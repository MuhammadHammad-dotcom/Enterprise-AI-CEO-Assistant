    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Email\",\n        \"Meeting\",\n        \"Sales\",\n        \"Finance\",\n        \"Reports\",\n        \"Research\",\n        \"General Task\"\n      ],\n      \"description\": \"The single business category the request belongs to.\"\n    },\n    \"reasoning\": {\n      \"type\": \"string\",\n      \"description\": \"One short sentence explaining the classification.\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One-line summary of what the CEO asked for.\"\n    },\n    \"result\": {\n      \"type\": \"string\",\n      \"description\": \"The fully generated deliverable: email body, meeting agenda, quotation, finance/payment summary, business report, research bullet points, or a general answer.\"\n    },\n    \"email_to\": {\n      \"type\": \"string\",\n      \"description\": \"Recipient email if the request is an Email, else empty string.\"\n    },\n    \"email_subject\": {\n      \"type\": \"string\",\n      \"description\": \"Email subject line if Email, else empty string.\"\n    },\n    \"meeting_title\": {\n      \"type\": \"string\",\n      \"description\": \"Meeting title if Meeting, else empty string.\"\n    },\n    \"meeting_start\": {\n      \"type\": \"string\",\n      \"description\": \"Meeting start in ISO 8601 (e.g. 2026-07-21T10:00:00) if Meeting, else empty string.\"\n    },\n    \"meeting_end\": {\n      \"type\": \"string\",\n      \"description\": \"Meeting end in ISO 8601 if Meeting, else empty string.\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"summary\",\n    \"result\"\n  ]\n}"
      },
